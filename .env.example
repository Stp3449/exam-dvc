# Copier en .env puis renseigner les valeurs. .env est ignoré par Git.
# Utilisé par src/models/train_model.py (chargé via python-dotenv) pour MLflow.
# Remplacer <USER> et <REPO> par votre utilisateur / dépôt DagsHub.

MLFLOW_TRACKING_URI=https://dagshub.com/<USER>/<REPO>.mlflow
MLFLOW_TRACKING_USERNAME=<USER>
MLFLOW_TRACKING_PASSWORD=<token_dagshub>

# Remarque : les identifiants du remote DVC S3 ne se mettent PAS ici
# (le CLI `dvc` ne lit pas .env). Les configurer en local avec :
#   dvc remote modify origin endpointurl https://dagshub.com/<USER>/<REPO>.s3
#   dvc remote modify --local origin access_key_id     <token_dagshub>
#   dvc remote modify --local origin secret_access_key <token_dagshub>
